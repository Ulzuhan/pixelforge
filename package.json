  "description": "Background removal and image vectorisation on your own hardware: rembg and vtracer behind a Next.js front, with strict limits on every job.",
  "license": "MIT",
  "author": "Ulzuhan",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ulzuhan/pixelforge.git"
  },
  "keywords": [
    "background-removal",
    "vectorizer",
    "rembg",
    "vtracer",
    "svg",
    "self-hosted",
    "nextjs"
