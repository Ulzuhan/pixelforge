    "@types/busboy": "^1.5.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.18",
    "nanoid": "3.3.18",
    "js-yaml": "^4.3.1",
    "brace-expansion": "^2.0.2"
  }
