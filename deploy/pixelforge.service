[Unit]
Description=PixelForge image processor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pixelforge
Group=pixelforge
WorkingDirectory=/opt/pixelforge
EnvironmentFile=/etc/pixelforge.env
Environment=NODE_ENV=production
Environment=PORT=3458
Environment=HOSTNAME=127.0.0.1
Environment=PIXELFORGE_TMP_DIR=/var/lib/pixelforge/tmp
Environment=PIXELFORGE_PYTHON=/opt/pixelforge-venv/bin/python3
Environment=U2NET_HOME=/var/lib/pixelforge/models
ExecStart=/usr/bin/node /opt/pixelforge/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pixelforge
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
MemoryMax=6G
TasksMax=512
CPUQuota=350%
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
