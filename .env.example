# Pixelforge — variables de entorno
#
# Copia este fichero a `.env.local` y rellena los valores. Sin `SESSION_SECRET`
# y sin cliente OIDC la aplicación no deja entrar a nadie: es deliberado, no un
# fallo de configuración.

# Firma las cookies de sesión. Genérala con:
#   openssl rand -hex 32
# Cambiarla invalida todas las sesiones abiertas.
PIXELFORGE_SESSION_SECRET=
# Duración de sesión: 1-24 horas; por defecto 12.
#PIXELFORGE_SESSION_TTL_HOURS=12

# ─── Proveedor de identidad (OIDC) ──────────────────────────────────────
# Credenciales del cliente, tal como las da el proveedor.
PIXELFORGE_OIDC_CLIENT_ID=
PIXELFORGE_OIDC_CLIENT_SECRET=

# A dónde vuelve el navegador tras iniciar sesión. Tiene que coincidir
# exactamente con la que esté registrada en el proveedor.
PIXELFORGE_OIDC_REDIRECT_URI=https://ejemplo.tudominio.com/api/auth/callback

# Dos direcciones para el mismo proveedor, a propósito:
#   PUBLIC    la que ve el navegador de quien inicia sesión.
#   INTERNAL  la que usa este servidor para canjear el código y leer los datos
#             del usuario. Si el proveedor corre en la misma máquina, apuntarla
#             a loopback evita salir a internet y volver.
PIXELFORGE_OIDC_PUBLIC_BASE=https://auth.tudominio.com
PIXELFORGE_OIDC_INTERNAL_BASE=http://127.0.0.1:9100

# Procesamiento y protección de recursos
#PIXELFORGE_PYTHON=/opt/pixelforge-venv/bin/python3
#PIXELFORGE_TMP_DIR=/var/lib/pixelforge/tmp
#PIXELFORGE_MAX_PIXELS=40000000
#PIXELFORGE_MAX_OUTPUT_BYTES=268435456
#PIXELFORGE_MAX_JOBS=2
#PIXELFORGE_MAX_QUEUE=6
#PIXELFORGE_MAX_REQUESTS_PER_HOUR=30
#PIXELFORGE_OIDC_APP_SLUG=pixelforge
